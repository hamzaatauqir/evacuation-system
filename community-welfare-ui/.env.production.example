# Production frontend (cwakuwait.com) is a static site on a different origin
# from the backend, so the backend origin must be absolute. Same-origin
# relative paths do NOT work here — the static site has no /api/*.
VITE_API_BASE_URL=https://evacuation-system.onrender.com
# Optional override for the public forms portal; falls back to VITE_API_BASE_URL.
# Never portal.cwakuwait.com — retired, answers 403.
VITE_BACKEND_PORTAL_URL=
