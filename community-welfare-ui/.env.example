# Backend origin for API calls (advertisements, forms, tracking) and for the
# /register, /apply, /transit alias redirects.
#
# The frontend (cwakuwait.com) and the backend are separate Render services on
# different origins, so this MUST be an absolute URL in production. Leaving it
# empty makes the build fall back to same-origin relative paths, which the
# static site cannot serve.
#
# Do NOT point this at portal.cwakuwait.com: that host is retired and answers
# 403, and is ignored by the resolver in src/lib/backendOrigin.ts.
VITE_API_BASE_URL=https://evacuation-system.onrender.com
# Optional override for the public forms portal; falls back to VITE_API_BASE_URL.
VITE_BACKEND_PORTAL_URL=
# Public site origin (used by some flows; nurse reset emails use server env NURSE_PORTAL_PUBLIC_URL)
VITE_APP_ORIGIN=https://cwakuwait.com
